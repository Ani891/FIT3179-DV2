{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: 100 squares, one per 100 caravan and camping trips; 87 are regional.",
  "width": 300,
  "height": 300,
  "data": {
    "url": "data/regional_trips.csv",
    "format": {
      "type": "csv",
      "parse": {
        "square": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.square % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.square / 10)",
      "as": "row"
    }
  ],
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.12
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.12
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Regional (87)",
          "Not regional (13)"
        ],
        "range": [
          "#1f8a8a",
          "#e3d5bd"
        ]
      }
    }
  }
}